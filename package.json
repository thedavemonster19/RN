{
  "name": "monster-claw-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calm, endless claw-machine puzzle where you dig for food to feed a growing monster.",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:edge && tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:edge": "node scripts/sync-edge-shared.mjs",
    "ios": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@supabase/supabase-js": "^2.110.7",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}